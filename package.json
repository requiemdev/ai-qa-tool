{
  "name": "agent-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-qa": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
