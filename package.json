    "test:runners": "npm run build && node --test dist/test/runners.integration.js",
    "test:live": "npm run build && node --test dist/test/live.integration.js"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "^1.63.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "vitest": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
